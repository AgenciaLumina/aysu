# Banco. Nunca preencher este arquivo com segredos reais.
# Vercel: PostgreSQL via PgBouncer com TLS e limite por instancia:
# postgresql://USUARIO:SENHA@HOST:6432/BANCO?sslmode=require&sslaccept=strict&connection_limit=2&pool_timeout=20&connect_timeout=15
# Confirmar HOST, certificado, versao/modo do PgBouncer e limite total no Loki.
DATABASE_URL=
# Operacao: conexao direta ao PostgreSQL via SSH para migracoes.
# A Vercel pode repetir DATABASE_URL aqui, pois o build NAO executa migracoes.
# Nunca executar prisma migrate usando esse valor pooled.
DIRECT_URL=

# Segurança operacional local
# Use 1 quando o ambiente local estiver conectado ao banco de produção.
# Preview: sempre 1, banco separado e sem chaves de envio/pagamento/storage.
# Producao: 0 somente na virada autorizada.
APP_READ_ONLY_MODE=1

# Autenticacao. Segredo aleatorio de pelo menos 32 caracteres.
# Na virada preservar o segredo de producao para manter as sessoes existentes.
JWT_SECRET=

# Hold de pendência de reserva (em minutos)
# 0 = comportamento legado (pendente sempre trava estoque)
PENDING_HOLD_MINUTES=0

# Site
# Em produção isso costuma ficar false.
MAINTENANCE_MODE=false

# E-mails transacionais (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL="Aysu Beach Lounge <contato@aysubeachlounge.com.br>"
CONTACT_TO_EMAIL="Aysubeachlounge@gmail.com,agencialuminabrasil@gmail.com"

# Midias persistentes: preservar o bucket e CDN atuais no Cloudflare R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=aysu
R2_ENDPOINT=
R2_PUBLIC_URL=https://cdn.aysubeachlounge.com.br

# Rede: opcionais, somente se o pagamento online for ativado separadamente.
# Ausentes na producao verificada em 26/10/2026; nao ativar nesta preparacao.
REDE_CLIENT_ID=
REDE_CLIENT_SECRET=
REDE_MERCHANT_ID=
REDE_WEBHOOK_SECRET=
REDE_API_URL=
REDE_OAUTH_URL=
